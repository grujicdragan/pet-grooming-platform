# Copy to api/.env and fill in Neon values (api/.env is gitignored).

SPRING_DATASOURCE_URL=jdbc:postgresql://ep-XXXX-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=replace-me

# Optional — comma-separated web origins for CORS (Render + Vercel later)
# APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,https://pet-grooming.vercel.app,https://pet-grooming-platform-seven.vercel.app

# JWT signing key — at least 32 characters. Override in production.
# APP_JWT_SECRET=replace-with-a-long-random-secret
# APP_JWT_TTL=8h

# Public web origin used in confirmation emails (verify-email link).
# Local:
# APP_WEB_ORIGIN=http://localhost:4200
# Production (Render):
# APP_WEB_ORIGIN=https://pet-grooming.vercel.app

# Email: `log` prints the verify link in API logs (and the register page).
# `resend` sends a real message — set both vars on Render.
# APP_MAIL_PROVIDER=log
# APP_MAIL_FROM=Šapelier <onboarding@resend.dev>
# RESEND_API_KEY=
#
# Production:
# APP_MAIL_PROVIDER=resend
# APP_MAIL_FROM=Šapelier <onboarding@resend.dev>
# RESEND_API_KEY=re_xxxxxxxx

